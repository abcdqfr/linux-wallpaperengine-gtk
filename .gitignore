# Standalone Monolith - Only track essential files
# Everything except linux-wallpaperengine-gtk.py and README.md

# Ignore everything by default
*

# But track these essential files
!linux-wallpaperengine-gtk.py
!README.md
!.gitignore
!LICENSE
!.pre-commit-config.yaml
!.releaserc.json
!pyproject.toml
!.github/
!.github/**
!.github/workflows/
!.github/workflows/**
# Forgejo Actions (canonical CI workflow path); `.github/workflows/ci.yml` symlinks here
!.forgejo/
!.forgejo/**
# Automated smoke tests (byte-compile / no GTK)
!tests/
!tests/**
# Local CI mirror + helpers
!scripts/
!scripts/**
!THIRD_PARTY_LICENSES.md

# Bundled upstream engine (git submodule)
!upstream/
!upstream/**

# In-repo documentation (reviews, internal notes)
!docs/
!docs/**

# Python artifacts (if any)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# Logs
*.log
wallpaper-engine.log

# OS
.DS_Store
Thumbs.db

# Git
.git/
.history/

# jscpd reports
.jscpd/
jscpd-report.*

# Git hooks (local only, not tracked)
.git/hooks/.pre-commit-executed
.git/hooks/.no-verify-log
